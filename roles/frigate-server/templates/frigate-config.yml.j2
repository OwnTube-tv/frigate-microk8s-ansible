# Frigate configuration — owned by Ansible (frigate-server role).
# Rendered from templates/frigate-config.yml.j2 with camera credentials from
# the Ansible Vault; mounted read-only into the pod, so the Frigate UI's
# config editor cannot persist changes. Edit the template, not the UI.

# Declared explicitly (CURRENT_CONFIG_VERSION for Frigate 0.17.x) — the config
# file is mounted read-only, so Frigate's startup migration must have nothing
# to do; without this key the migration tries to write and fails the start.
version: 0.17-0

mqtt:
  enabled: false

# TLS terminates in the MicroK8s ingress (cert-manager/Let's Encrypt)
tls:
  enabled: false

ui:
  # Explicit 24-hour time. Works around upstream Frigate 0.17 bugs: the
  # timeline falls back to the i18n "12hour" format strings whenever this is
  # not exactly "24hour", and the Swedish 12-hour strings contain an unescaped
  # "kl." literal that makes date-fns throw ("Invalid time" across the review
  # timeline). Tracked in issue #5.
  time_format: 24hour

detectors:
  ov:
    type: openvino
    device: GPU

model:
  width: 300
  height: 300
  input_tensor: nhwc
  input_pixel_format: bgr
  path: /openvino-model/ssdlite_mobilenet_v2.xml
  labelmap_path: /openvino-model/coco_91cl_bkgr.txt

ffmpeg:
  hwaccel_args: preset-vaapi

go2rtc:
  # Every camera is published twice, main and sub, because Frigate gives the
  # two streams different jobs and needs both.
  #
  # The main stream carries the 'record' role. It is stream-copied to disk and
  # never decoded, so its resolution drives disk usage and nothing else — that
  # is the stream the ~2.5 GB/h measurement is about. All three main streams
  # are HEVC, probed 2026-08-27, camera 1 included and therefore since before
  # the cutover. Frigate plays HEVC recordings back in Chrome 108+, Edge and
  # Safari only, which the TrackMix footage has been quietly proving is
  # good enough here for two weeks.
  #
  # The substream carries 'detect' and is the only one decoded, on the iGPU,
  # for motion and object detection. Its resolution is therefore what sets the
  # decode load and the /dev/shm budget: 32 MB across these three substreams,
  # against 312 MB if detection ran on the main streams instead — on a
  # 4-thread i5-7200U that also has to encode nothing and decode everything.
  # All three substreams are H.264, so the i965 VAAPI driver this box is
  # pinned to never has to decode HEVC at all.
  #
  # Every stream, main and sub, carries AAC audio — measured, not assumed,
  # which is what makes preset-record-generic-audio-aac right on all three.
  #
  # This is also why both resolutions get recorded below rather than just the
  # main ones: boxes are found on the substream and drawn over the main.
  streams:
    # Camera 1 — Reolink TrackMix P760. Its two lenses are independent
    # channels: 01 is the wide lens, 02 the telephoto.
    trackmix_wide:
      - rtsp://{{ frigate_camera_1_username }}:{{ frigate_camera_1_password }}@{{ frigate_camera_1_host }}:554/h264Preview_01_main
    trackmix_wide_sub:
      - rtsp://{{ frigate_camera_1_username }}:{{ frigate_camera_1_password }}@{{ frigate_camera_1_host }}:554/h264Preview_01_sub
    trackmix_tele:
      - rtsp://{{ frigate_camera_1_username }}:{{ frigate_camera_1_password }}@{{ frigate_camera_1_host }}:554/h264Preview_02_main
    trackmix_tele_sub:
      - rtsp://{{ frigate_camera_1_username }}:{{ frigate_camera_1_password }}@{{ frigate_camera_1_host }}:554/h264Preview_02_sub

    # Cameras 2 and 3 — Reolink Duo 2 and Duo 2V. Unlike the TrackMix these
    # stitch both lenses into one panoramic image carried on channel 01, so
    # each is a single stream pair and a single Frigate camera.
    #
    # They use Reolink's canonical "/Preview_01_*" path rather than the
    # "h264Preview_01_*" form above. Probed over the site VPN 2026-08-27, the
    # prefix is decorative on these cameras: "Preview_01_main",
    # "h264Preview_01_main" and "h265Preview_01_main" all return the same
    # HEVC stream. The bare form is preferred for not claiming a codec the
    # camera is not sending — not because the prefixed one would fail.
    driveway_duo_2_w:
      - rtsp://{{ frigate_camera_2_username }}:{{ frigate_camera_2_password }}@{{ frigate_camera_2_host }}:554/Preview_01_main
    driveway_duo_2_w_sub:
      - rtsp://{{ frigate_camera_2_username }}:{{ frigate_camera_2_password }}@{{ frigate_camera_2_host }}:554/Preview_01_sub
    back_yard_duo_2v_e:
      - rtsp://{{ frigate_camera_3_username }}:{{ frigate_camera_3_password }}@{{ frigate_camera_3_host }}:554/Preview_01_main
    back_yard_duo_2v_e_sub:
      - rtsp://{{ frigate_camera_3_username }}:{{ frigate_camera_3_password }}@{{ frigate_camera_3_host }}:554/Preview_01_sub

cameras:
  # A camera's key must match ^[a-zA-Z0-9_-]+$, and with nothing else set
  # Frigate labels it by title-casing that key — "trackmix_wide" would read
  # "Trackmix Wide" in the UI. 'friendly_name' is what carries the real label,
  # spaces and capitalisation included.
  #
  # It is also why camera 1 keeps its original key. The key names the
  # recording directories under /media/frigate/recordings and is what every
  # event row in the database points at, so renaming it would orphan
  # everything recorded since the cutover on 2026-08-13. The label moves; the
  # key stays.
  #
  # Camera 1's wide channel is off. Not a capacity measure — the two Duo
  # panoramas overlap and cover this view between them, so a third wide angle
  # records nothing that is not already held from two other directions. What
  # the TrackMix contributes now is the telephoto channel below.
  #
  # Left fully defined, so re-enabling is this one key. It would have to come
  # back from here rather than from the UI: Frigate refuses an enable command
  # for a camera that was false in the config at startup. Footage already
  # recorded under this name stays on disk and ages out normally.
  trackmix_wide:
    friendly_name: Back Yard TrackMix NE
    enabled: false
    ffmpeg:
      output_args:
        # The camera's main stream carries AAC audio
        record: preset-record-generic-audio-aac
      inputs:
        - path: rtsp://127.0.0.1:8554/trackmix_wide
          input_args: preset-rtsp-restream
          roles: [record]
        - path: rtsp://127.0.0.1:8554/trackmix_wide_sub
          input_args: preset-rtsp-restream
          roles: [detect]
    detect:
      enabled: true
      width: 896
      height: 512
      fps: 5
    objects:
      track: [horse, person, car, dog]
    # Manual PTZ from the Frigate UI (the a264a-frigate-admin camera account
    # has PTZ rights). Frigate's own autotracking stays off — Reolink does not
    # support ONVIF RelativeMove.
    onvif:
      host: {{ frigate_camera_1_host }}
      port: 8000
      user: {{ frigate_camera_1_username }}
      password: {{ frigate_camera_1_password }}

  # Camera 1's telephoto channel — an 8 mm lens at 38 degrees against the wide
  # channel's 2.8 mm at 96. It records in its own right now that the two Duo
  # panoramas overlap and cover the overview between them, which frees the
  # TrackMix to be the detail camera rather than a third wide view.
  #
  # The camera serves this channel at 1080p out of the box, even though the
  # P760 carries a 4K sensor behind both lenses. That is an encoder setting on
  # the camera itself (GetEnc channel 1, mainStream) rather than a limit, and
  # its own API lists 3840x2160 as supported. detect.width/height stay unset
  # here for the same reason they do on the Duos: raising the camera's setting
  # should not require a matching edit in this file.
  #
  # The camera's own tracking follows subjects digitally within this frame. It
  # can be configured to drive the PTZ motors as well, but that stays off, and
  # so does Frigate's autotracking — Reolink does not support ONVIF
  # RelativeMove. The onvif block is repeated here because this is now the
  # lens worth aiming, and both entries address the same physical head.
  trackmix_tele:
    friendly_name: Back Yard TrackMix NE (Tele)
    ffmpeg:
      output_args:
        record: preset-record-generic-audio-aac
      inputs:
        - path: rtsp://127.0.0.1:8554/trackmix_tele
          input_args: preset-rtsp-restream
          roles: [record]
        - path: rtsp://127.0.0.1:8554/trackmix_tele_sub
          input_args: preset-rtsp-restream
          roles: [detect]
    detect:
      enabled: true
      fps: 5
    objects:
      track: [horse, person, car, dog]
    onvif:
      host: {{ frigate_camera_1_host }}
      port: 8000
      user: {{ frigate_camera_1_username }}
      password: {{ frigate_camera_1_password }}

  # Camera 2 — the driveway, facing west. Fixed lenses, so there is no onvif
  # block: that section exists for PTZ control and there is nothing to move.
  #
  # detect.width/height stay unset here and on camera 3 — Frigate reads the
  # geometry off the stream instead. All three cameras measured 2026-08-27:
  #
  #                        main stream     substream     aspect main/sub
  #   camera 1 wide        3840x2160        896x512      1.778 / 1.750
  #   camera 1 telephoto   1920x1080        896x512      1.778 / 1.750
  #   camera 2 (Duo 2)     4608x1728       1536x576      2.667 / 2.667
  #   camera 3 (Duo 2V)    5120x1552       1920x576      3.299 / 3.333
  #
  # The two panoramas are not the same shape as each other, so there was never
  # one pair of numbers to hard-code for both; reading it off the stream also
  # keeps a resolution change in the Reolink app from turning into a mismatch
  # Frigate has to fault on. Camera 1 keeps its explicit pair above, which the
  # measurement confirms.
  #
  # On the last column: boxes are computed on the substream and drawn over the
  # main, so a camera whose two aspects disagree places them slightly off.
  # Camera 1 is out by 1.56% and has been since the cutover with nobody
  # noticing, camera 3 by 1.04%, camera 2 not at all. That ranking is the
  # measure of how much it matters — do not go chasing it as a Duo defect.
  driveway_duo_2_w:
    friendly_name: Driveway Duo 2 W
    ffmpeg:
      output_args:
        record: preset-record-generic-audio-aac
      inputs:
        - path: rtsp://127.0.0.1:8554/driveway_duo_2_w
          input_args: preset-rtsp-restream
          roles: [record]
        - path: rtsp://127.0.0.1:8554/driveway_duo_2_w_sub
          input_args: preset-rtsp-restream
          roles: [detect]
    detect:
      enabled: true
      fps: 5
    objects:
      track: [horse, person, car, dog]

  # Camera 3 — the back yard, facing east, opposite the TrackMix.
  back_yard_duo_2v_e:
    friendly_name: Back Yard Duo 2V E
    ffmpeg:
      output_args:
        record: preset-record-generic-audio-aac
      inputs:
        - path: rtsp://127.0.0.1:8554/back_yard_duo_2v_e
          input_args: preset-rtsp-restream
          roles: [record]
        - path: rtsp://127.0.0.1:8554/back_yard_duo_2v_e_sub
          input_args: preset-rtsp-restream
          roles: [detect]
    detect:
      enabled: true
      fps: 5
    objects:
      track: [horse, person, car, dog]

record:
  enabled: true
  # 3 days of 24/7 footage (~60 GB/day/4K-stream measured), then motion-only
  # segments up to 7 days, with event footage kept longest below. Frigate
  # prunes the oldest material if the disk fills up regardless.
  continuous:
    days: 3
  motion:
    days: 7
  alerts:
    retain:
      days: 30
  detections:
    retain:
      days: 30

snapshots:
  enabled: true
  retain:
    default: 30
